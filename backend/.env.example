NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/has
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Secrets
#
# The `dev-*-change-me` values exist so a fresh clone runs locally with no setup.
# When NODE_ENV=production the server refuses to start if any of them is still in
# place, or if JWT_ACCESS_SECRET, JWT_REFRESH_SECRET and OTP_SECRET are not all
# distinct. Generate each with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=dev-otp-secret-change-me

# Demo data is created by `npm run seed`, which also creates the super admin below.
# Turning this on additionally runs src/seed.ts, which writes a second overlapping set of
# hospital fixtures, so it stays off.
SEED_ON_START=false
SEED_SUPER_ADMIN_EMAIL=admin@has.local
# Also refused in production while left at the default.
SEED_SUPER_ADMIN_PASSWORD=Admin@12345

# ---------------------------------------------------------------------------
# Reverse proxy
#
# Express reads the client address from X-Forwarded-For only when this is set, and
# that value is written to every audit entry. Leave unset when the app is exposed
# directly. Behind exactly one proxy set 1. `true` trusts the header unconditionally
# and is only safe if nothing but your own proxy can reach the app — otherwise a
# client can spoof its own address in the audit trail.
# ---------------------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# One-time codes
# ---------------------------------------------------------------------------
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# SMS gateway
# ---------------------------------------------------------------------------
SMS_PROVIDER=log

# Shared secret for the inbound webhook at POST /api/appointments/sms. The gateway
# signs `${timestamp}.${rawBody}` with HMAC-SHA256 hex and sends it as
# X-SMS-Signature, alongside X-SMS-Timestamp and optionally X-SMS-Delivery-Id.
# While this is empty the webhook refuses every request rather than accepting
# unsigned traffic.
SMS_WEBHOOK_SECRET=
SMS_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Test-only
#
# Accepts the `x-test-user` header as a password-less login for the account with
# that email. Requires NODE_ENV=test as well, so a misconfigured production
# process cannot enable it. Never set this outside the test suite.
# ---------------------------------------------------------------------------
ALLOW_TEST_AUTH=false
